---
// Report contract 2026-11-11.4: capacity median trend is the battery headline; high-power is driving stats only.
const { data } = Astro.props as { data: any };
const n = (v: number | null | undefined, unit = "", digits?: number) =>
  v === null || v === undefined ? "데이터 부족" : `${digits !== undefined ? v.toFixed(digits) : v.toLocaleString("ko-KR")}${unit}`;
const won = (v: number | null | undefined) => (v === null || v === undefined ? "—" : `${v.toLocaleString("ko-KR")}원`);
const signed = (v: number | null | undefined, unit = "") => (v === null || v === undefined ? "" : `${v > 0 ? "+" : ""}${v}${unit}`);
const ds = data.drive_summary; const lt = data.lifetime_totals; const cc = data.charging_cost;
const ge = data.gasoline_equivalent; const ef = data.efficiency; const bc = data.battery_condition; const vi = data.vehicle_info;
const hours = (m: number | null) => (m === null || m === undefined ? "데이터 부족" : `${Math.floor(m / 60)}시간 ${m % 60}분`);
const capTrend = (data.capacity_trend ?? []) as { month: string; capacity_kwh: number | null; ma3_kwh?: number | null; session_count?: number | null }[];
const capVals = capTrend.flatMap((t) => [t.capacity_kwh, t.ma3_kwh ?? null]).filter((v): v is number => v != null);
const cMin = capVals.length ? Math.floor((Math.min(...capVals) - 0.5) * 2) / 2 : 0;
const cMax = capVals.length ? Math.ceil((Math.max(...capVals) + 0.5) * 2) / 2 : 1;
const W = 720, H = 200, L = 50, R = 16, T = 20, B = 34; const pw = W - L - R, ph = H - T - B;
const cx = (i: number) => (capTrend.length <= 1 ? L + pw / 2 : L + (pw * i) / (capTrend.length - 1));
const cy = (v: number) => T + ph - ((v - cMin) / Math.max(cMax - cMin, 1)) * ph;
let capStarted = false;
const capPath = capTrend.map((t, i) => {
  if (t.capacity_kwh == null) return "";
  const cmd = capStarted ? "L" : "M";
  capStarted = true;
  return `${cmd}${cx(i)} ${cy(t.capacity_kwh)}`;
}).filter(Boolean).join(" ");
let ma3Started = false;
const ma3Path = capTrend.map((t, i) => {
  if (t.ma3_kwh == null) return "";
  const cmd = ma3Started ? "L" : "M";
  ma3Started = true;
  return `${cmd}${cx(i)} ${cy(t.ma3_kwh)}`;
}).filter(Boolean).join(" ");
const hasMa3 = capTrend.some((t) => t.ma3_kwh != null);
const latestCap = [...capTrend].reverse().find((t) => t.capacity_kwh != null);
const latestMa3 = [...capTrend].reverse().find((t) => t.ma3_kwh != null);
const trend = bc?.range_at_100_trend ?? [];
const tv = trend.flatMap((row: any) => [row.range_at_100_km, row.ma4_km]).filter((v: any) => v !== null);
const tMin = tv.length ? Math.floor(Math.min(...tv) - 2) : 0; const tMax = tv.length ? Math.ceil(Math.max(...tv) + 2) : 1;
const tx = (i: number) => (trend.length <= 1 ? L + pw / 2 : L + (pw * i) / (trend.length - 1));
const ty = (v: number) => T + ph - ((v - tMin) / Math.max(tMax - tMin, 1)) * ph;
const ma = trend.map((row: any, i: number) => (row.ma4_km === null ? null : [tx(i), ty(row.ma4_km)])).filter(Boolean) as number[][];
const maPath = ma.map((pt, i) => `${i ? "L" : "M"}${pt[0]} ${pt[1]}`).join(" ");
const showBattery = !!bc || capTrend.some((t) => t.capacity_kwh != null);
---
<section class="vehicle-v3" aria-label="주간 차량관리 요약">
  {ds && <div class="v3-card"><h2>🚗 운행 요약</h2><dl class="v3-grid">
    <div><dt>주행거리</dt><dd>{n(ds.distance_km, " km")}</dd></div>
    <div><dt>운행 횟수</dt><dd>{n(ds.drive_count, "회")}</dd></div>
    <div><dt>총 운행시간</dt><dd>{hours(ds.drive_time_min)}</dd></div>
    <div><dt>평균 속도</dt><dd>{n(ds.avg_speed_kmh, " km/h")}</dd></div>
    <div><dt>최고 속도</dt><dd>{n(ds.max_speed_kmh, " km/h")}</dd></div>
    <div><dt>최장 운행</dt><dd>{n(ds.longest_drive_km, " km")}{ds.longest_drive_date && <small> ({ds.longest_drive_date})</small>}</dd></div>
  </dl></div>}
  {cc && <div class="v3-card"><h2>⚡ 충전과 비용</h2>
    <dl class="v3-grid">
      <div><dt>이번 주 충전</dt><dd>{n(cc.week.total_kwh, " kWh")}</dd></div>
      <div><dt>이번 주 비용</dt><dd>{won(cc.week.total_cost_krw)}</dd></div>
      <div><dt>1 km당 비용</dt><dd>{n(cc.week.cost_per_km_krw, "원")}</dd></div>
    </dl>
    <table><thead><tr><th>구분</th><th>결제 카드</th><th>충전량</th><th>실질 비용</th><th>카드 혜택</th></tr></thead><tbody>
      <tr><td>집</td><td><small>{cc.cards?.home ?? "—"}</small></td><td>{n(cc.week.home_kwh, " kWh")}</td><td>{won(cc.week.home_cost_krw)}</td><td>{cc.week.home_card_points_krw != null ? `적립 ${won(cc.week.home_card_points_krw)}` : ""}</td></tr>
      <tr><td>회사</td><td><small>{cc.cards?.work ?? "—"}</small></td><td>{n(cc.week.work_kwh, " kWh")}</td><td>{won(cc.week.work_cost_krw)}</td><td>할인 {won(cc.week.work_discount_krw)}</td></tr>
      <tr><td>급속충전</td><td><small>{cc.cards?.fast ?? "—"}</small></td><td>{n(cc.week.fast_kwh ?? cc.week.other_kwh, " kWh")}</td><td>{won(cc.week.fast_cost_krw ?? cc.week.other_cost_krw)}</td><td>{cc.rates?.fast_krw_per_kwh ? `${cc.rates.fast_krw_per_kwh}원/kWh 가정` : "단가 미설정"}{cc.week.fast_card_points_krw != null && ` · 적립 ${won(cc.week.fast_card_points_krw)}`}</td></tr>
    </tbody></table>
    {cc.months?.length > 0 && <table><thead><tr><th>월</th><th>집</th><th>회사</th><th>삼성 할인 한도</th><th>그린카드 적립 한도(집+급속)</th><th>급속충전</th><th>비용 합계</th></tr></thead><tbody>
      {cc.months.map((m: any) => <tr><td>{m.month}</td><td>{n(m.home_kwh, " kWh")}<br /><small>{won(m.home_cost_krw)}</small></td><td>{n(m.work_kwh, " kWh")}<br /><small>{won(m.work_cost_krw)}</small></td>
        <td>{won(m.work_discount_krw)} / {won(m.work_discount_cap_krw)}<div class="v3-bar"><span style={`width:${Math.min(100, ((m.work_discount_krw ?? 0) / (m.work_discount_cap_krw || 1)) * 100)}%`}></span></div></td>
        <td>{m.green_points_krw != null ? <>{won(m.green_points_krw)} / {won(m.green_points_cap_krw)}<div class="v3-bar"><span style={`width:${Math.min(100, (m.green_points_krw / (m.green_points_cap_krw || 1)) * 100)}%`}></span></div></> : "—"}</td>
        <td>{n(m.fast_kwh ?? m.other_kwh, " kWh")}<br /><small>{won(m.fast_cost_krw ?? m.other_cost_krw)}</small></td><td><strong>{won(m.total_cost_krw ?? m.known_cost_krw)}</strong></td></tr>)}
    </tbody></table>}
    {cc.monthly_history?.length > 0 && <table><thead><tr><th>월</th><th>충전비용</th><th>주행</th><th>원/km</th></tr></thead><tbody>{cc.monthly_history.map((h: any) => <tr><td>{h.month}</td><td>{won(h.total_cost_krw)}</td><td>{n(h.distance_km, " km")}</td><td>{n(h.cost_per_km_krw, "원")}</td></tr>)}</tbody></table>}
    {cc.monthly_avg_cost_krw != null && <p>월평균 충전비용: <strong>{won(cc.monthly_avg_cost_krw)}</strong> <small>(최근 {cc.monthly_avg_months}개월)</small></p>}
    {cc.note && <p class="chart-method-note">{cc.note}</p>}
  </div>}
  {ge && <div class="v3-card"><h2>⛽ 휘발유 환산</h2>
    <table><thead><tr><th>기간</th><th>환산 연비</th><th>환산 L/100km</th><th>휘발유차({ge.reference_km_per_l} km/L) 주유비</th><th>실제 충전비</th><th>절감액</th></tr></thead><tbody>
      {[["이번 주", ge.week], [ge.month?.month ?? "월", ge.month]].filter(([, v]) => v).map(([label, v]: any) => <tr><td>{label}</td><td>{n(v.km_per_l_equiv, " km/L")}</td><td>{n(v.l_per_100km_equiv, " L")}</td><td>{won(v.gasoline_car_cost_krw)}</td><td>{won(v.charging_cost_krw)}</td><td><strong>{won(v.savings_krw)}</strong></td></tr>)}
    </tbody></table>
    <p class="chart-method-note">{ge.price_source ?? "휘발유"} {n(ge.gasoline_price_krw_per_l, "원/L")} ({ge.price_date}) 기준. 환산 연비 = 휘발유 가격 ÷ 1 km당 충전비.</p></div>}
  {ef && <div class="v3-card"><h2>🔋 효율</h2><dl class="v3-grid">
    <div><dt>주간 효율</dt><dd>{n(ef.wh_per_km, " Wh/km")} <small>{signed(ef.wh_per_km_delta)} 전주 대비</small></dd></div>
    <div><dt>전주 효율</dt><dd>{n(ef.prior_wh_per_km, " Wh/km")}</dd></div>
    <div><dt>주차 중 소모</dt><dd>{n(ef.parked_drain_pct_per_day, "%/일")} <small>(전주 {n(ef.prior_parked_drain_pct_per_day, "%")})</small></dd></div>
  </dl>{ef.method && <p class="chart-method-note">{ef.method}</p>}</div>}
  {showBattery && <div class="v3-card"><h2>배터리 추세</h2>
    <dl class="v3-grid">
      <div><dt>최근 월 추정 용량</dt><dd>{latestCap ? `${n(latestCap.capacity_kwh, " kWh")}` : "데이터 부족"}{latestCap && <small> ({latestCap.month})</small>}</dd></div>
      <div><dt>3개월 이동 중앙값</dt><dd>{latestMa3 ? n(latestMa3.ma3_kwh, " kWh") : "데이터 부족"}</dd></div>
      <div><dt>기준월 대비</dt><dd>{bc?.vs_baseline_pct != null ? <>{signed(bc.vs_baseline_pct, "%")}{bc.baseline_month && <small> ({bc.baseline_month} {n(bc.baseline_capacity_kwh, " kWh")})</small>}</> : "데이터 부족"}</dd></div>
    </dl>
    {capTrend.some((row) => row.capacity_kwh != null) && <figure><figcaption><strong>월별 추정 가용용량</strong> <small>{hasMa3 ? "(실선: 월 값, 점선: 3개월 이동 중앙값)" : "(충전 세션 기반 추정)"}</small></figcaption>
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="월별 추정 가용용량 추세">
        {[0, 1, 2].map((s) => <line x1={L} x2={W - R} y1={T + (ph * s) / 2} y2={T + (ph * s) / 2} class="chart-grid-line" />)}
        {[cMax, (cMin + cMax) / 2, cMin].map((v, s) => <text x={L - 6} y={T + (ph * s) / 2 + 4} text-anchor="end" class="chart-axis-label">{v.toFixed(1)}</text>)}
        <path d={capPath} class="chart-capacity-line" />
        {hasMa3 && <path d={ma3Path} class="chart-capacity-line chart-ma3-line" />}
        {capTrend.map((row, i) => row.capacity_kwh != null && <circle class="chart-capacity-point" cx={cx(i)} cy={cy(row.capacity_kwh)} r="5"><title>{`${row.month} · ${row.capacity_kwh} kWh${row.ma3_kwh != null ? ` · 3개월 이동 중앙값 ${row.ma3_kwh} kWh` : ""}`}</title></circle>)}
        {capTrend.map((row, i) => <text x={cx(i)} y={H - 10} text-anchor="middle" class="chart-axis-label">{row.month.slice(5)}</text>)}
      </svg></figure>}
    {bc && <p class="chart-method-note-drive">이번 주 운행 참고: 고출력 주행({bc.high_power_threshold_kw ?? 180} kW+) {n(bc.high_power_drive_count, "회")}{bc.high_power_peak_kw != null && ` · 최고 ${n(bc.high_power_peak_kw, " kW")}`} · 급속충전 {n(bc.dc_fast_charge_count, "회")}. 운행 통계이며 열화와 연결하지 않습니다.</p>}
    {trend.length > 0 && <details class="vehicle-chart-table"><summary>100% 환산 주행가능거리 (참고)</summary>
      <figure><figcaption><strong>100% 환산 주행가능거리</strong> <small>(점: 주간 값, 선: 4주 이동평균)</small></figcaption>
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="100% 환산 주행가능거리 추세">
          {[0, 1, 2].map((s) => <line x1={L} x2={W - R} y1={T + (ph * s) / 2} y2={T + (ph * s) / 2} class="chart-grid-line" />)}
          {[tMax, (tMin + tMax) / 2, tMin].map((v, s) => <text x={L - 6} y={T + (ph * s) / 2 + 4} text-anchor="end" class="chart-axis-label">{Math.round(v)}</text>)}
          <path d={maPath} class="chart-capacity-line" />
          {trend.map((row: any, i: number) => row.range_at_100_km !== null && <circle class="chart-capacity-point" cx={tx(i)} cy={ty(row.range_at_100_km)} r="5"><title>{`${row.week_start} 주 · ${row.range_at_100_km} km · 4주평균 ${row.ma4_km ?? "—"} km`}</title></circle>)}
          {trend.map((row: any, i: number) => <text x={tx(i)} y={H - 10} text-anchor="middle" class="chart-axis-label">{row.week_start.slice(5)}</text>)}
        </svg></figure>
      <table><thead><tr><th>주 시작</th><th>100% 환산</th><th>4주 평균</th></tr></thead><tbody>{trend.map((row: any) => <tr><td>{row.week_start}</td><td>{n(row.range_at_100_km, " km")}</td><td>{n(row.ma4_km, " km")}</td></tr>)}</tbody></table>
    </details>}
    <p class="chart-method-note">{bc?.method ?? "2026-11-16 주간부터는 SOC가 30%p 이상 오른 충전 세션의 월 중앙값입니다. 그 이전 월은 평균값일 수 있습니다. 추세 관찰용이며 열화나 원인을 확정하지 않습니다."}{bc?.note ? ` ${bc.note}` : ""}</p>
  </div>}
  {lt && <div class="v3-card"><h2>📈 누적 기록 <small>({lt.as_of} 기준)</small></h2><dl class="v3-grid">
    <div><dt>총 주행거리</dt><dd>{n(lt.odometer_km, " km")}</dd></div>
    <div><dt>총 운행 횟수</dt><dd>{n(lt.drive_count, "회")}</dd></div>
    <div><dt>총 충전 횟수</dt><dd>{n(lt.charge_count, "회")}</dd></div>
    <div><dt>총 충전량</dt><dd>{n(lt.charged_kwh, " kWh")}</dd></div>
  </dl></div>}
  {vi && <div class="v3-card"><h2>🛠 차량 정보</h2><p>현재 소프트웨어: <strong>{vi.software_version ?? "데이터 부족"}</strong></p>
    {vi.update_history?.length > 0 && <table><thead><tr><th>버전</th><th>업데이트 날짜</th></tr></thead><tbody>{vi.update_history.map((u: any) => <tr><td>{u.version}</td><td>{u.date}</td></tr>)}</tbody></table>}</div>}
</section>
<style>
  .vehicle-v3 { display: grid; gap: 16px; margin: 26px 0; }
  .v3-card { border: var(--border-thin); background: var(--surface); box-shadow: var(--shadow-sm); padding: 14px 16px; overflow-x: auto; }
  .v3-card h2 { margin: 0 0 10px; font-size: 1.15rem; }
  .v3-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 0 0 10px; }
  .v3-grid div { display: grid; gap: 2px; }
  .v3-grid dt { color: var(--muted); font-size: .85rem; }
  .v3-grid dd { margin: 0; font-weight: 700; font-size: 1.05rem; }
  .v3-grid small, .v3-card h2 small { font-weight: 400; color: var(--muted); }
  .v3-card table { width: 100%; margin: 8px 0; }
  .v3-bar { height: 6px; background: var(--muted); opacity: .9; margin-top: 4px; position: relative; }
  .v3-bar span { position: absolute; inset: 0 auto 0 0; background: var(--yellow, #e6b800); }
  .v3-card svg { width: 100%; height: auto; min-width: 480px; }
  @media (max-width: 720px) { .v3-grid { grid-template-columns: repeat(2, 1fr); } }
  .chart-ma3-line { stroke-dasharray: 6 5; opacity: .85; }
  .chart-method-note-drive { color: var(--muted); font-size: .9rem; margin: 8px 0; }
</style>
