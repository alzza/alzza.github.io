---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "" } = Astro.props;
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          document.documentElement.setAttribute("data-theme", t === "dark" ? "dark" : "light");
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content="#FFD23F" data-light="#FFD23F" data-dark="#14131a" />
  </head>
  <body>
    <div id="top-sentinel" aria-hidden="true"></div>
    <slot />
    <button class="back-to-top" id="back-to-top" type="button" aria-label="맨 위로">↑</button>
    <script is:inline src="/theme.js"></script>
  </body>
</html>
