---
import {
  ULSAN,
  spots,
  courses,
  kakaoByCar,
  coursePoints,
  pickSpots,
} from "../../data/chuncheon";

const kakaoKey = import.meta.env.PUBLIC_KAKAO_JS_KEY ?? "";
const picks = pickSpots();
const payload = JSON.stringify({
  ulsan: ULSAN,
  spots,
  courses,
  pickCount: picks.length,
  urls: {
    base: kakaoByCar(coursePoints("base")),
    d27: kakaoByCar(coursePoints("d27")),
    d28: kakaoByCar(coursePoints("d28")),
    d29: kakaoByCar(coursePoints("d29")),
  },
});
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem("theme");
        document.documentElement.setAttribute("data-theme", t === "dark" ? "dark" : "light");
      } catch (e) {
        document.documentElement.setAttribute("data-theme", "light");
      }
    })();
  </script>
  <title>큰 지도 · 춘천</title>
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#FFD23F" data-light="#FFD23F" data-dark="#14131a" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <style is:global>
    :root {
      --ink:#111; --text:#111; --muted:#5c564e; --surface:#fffdf8; --bg:#fff7e0;
      --yellow:#ffd23f;
    }
    [data-theme="dark"] {
      --ink:#f3f3f6; --text:#ececed; --muted:#a6a6b0; --surface:#1f1e28; --bg:#14131a;
    }
    * { box-sizing: border-box; }
    html, body {
      height:100%; margin:0; background:var(--bg); color:var(--text);
      font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Apple SD Gothic Neo",sans-serif;
    }
    #map { position:absolute; inset:0; }
    .leaflet-div-icon { background:transparent; border:0; }
    .leaflet-control-attribution { font-size:10px !important; }

    .top {
      position:absolute; top:12px; left:12px; right:12px; z-index:500;
      display:flex; align-items:center; gap:8px;
    }
    .brand-chip {
      display:flex; align-items:center; gap:8px; flex:0 0 auto;
      height:44px; padding:0 12px 0 8px;
      background:var(--surface); border:3px solid var(--ink);
      box-shadow:4px 4px 0 var(--ink); text-decoration:none; color:inherit; font-weight:800;
    }
    .brand-chip i {
      width:26px; height:26px; display:grid; place-items:center;
      background:var(--yellow); border:2px solid var(--ink); font-style:normal; font-size:13px; color:#111;
    }
    .tabs {
      display:flex; gap:6px; flex:1; min-width:0;
      overflow-x:auto; scrollbar-width:none;
    }
    .tabs::-webkit-scrollbar { display:none; }
    .tabs button, .icon-btn {
      appearance:none; height:44px; padding:0 12px; flex:0 0 auto;
      border:3px solid var(--ink); background:var(--surface); color:var(--text);
      box-shadow:3px 3px 0 var(--ink); font:800 13px/1 inherit; cursor:pointer;
    }
    .tabs button.on { background:var(--ink); color:var(--bg); }
    .tabs button:active, .icon-btn:active { transform:translate(1px, 1px); box-shadow:2px 2px 0 var(--ink); }
    .icon-btn { width:44px; padding:0; margin-left:auto; }
    .theme-toggle svg { width:18px; height:18px; display:block; margin:0 auto; }
    .theme-toggle .icon-sun { display:none; }
    [data-theme="dark"] .theme-toggle .icon-moon { display:none; }
    [data-theme="dark"] .theme-toggle .icon-sun { display:block; }

    .dock {
      position:absolute; z-index:500; top:68px; left:12px;
      width:min(360px, calc(100vw - 24px));
      max-height:calc(100dvh - 88px);
      display:flex; flex-direction:column;
      background:var(--surface); border:3px solid var(--ink);
      box-shadow:6px 6px 0 var(--ink);
    }
    .dock header { padding:14px 14px 10px; border-bottom:3px solid var(--ink); }
    .dock header p { margin:6px 0 0; font-size:13px; color:var(--muted); line-height:1.45; }
    .dock h1 { margin:0; font-size:20px; letter-spacing:-0.03em; }
    .list { list-style:none; margin:0; padding:0; overflow:auto; }
    .list li {
      display:grid; grid-template-columns:1fr auto; gap:8px; align-items:start;
      border-bottom:1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    }
    .list button {
      display:grid; grid-template-columns:28px 1fr; gap:10px; align-items:start;
      width:100%; text-align:left; border:0;
      background:transparent; color:inherit; padding:11px 4px 11px 14px; font:inherit; cursor:pointer;
    }
    .list li:hover, .list li.is-on { background:var(--yellow); color:#111; }
    .list li:hover .meta, .list li.is-on .meta { color:#1a1a1a; }
    .side { display:flex; flex-direction:column; align-items:flex-end; gap:6px; padding:11px 14px 11px 0; }
    .num {
      width:26px; height:26px; display:grid; place-items:center;
      border:2px solid #111; font:800 12px/1 inherit; color:#111;
    }
    .num.water { background:#74b9ff; }
    .num.sc { background:#ff6b6b; }
    .num.poi { background:#ffd23f; }
    .num.food { background:#ffa552; }
    .num.stay { background:#88d498; }
    .list b { display:block; font-size:14px; }
    .meta { display:block; margin-top:3px; font-size:12px; color:var(--muted); line-height:1.4; }
    .mins { font-size:11px; font-weight:800; white-space:nowrap; }
    .place {
      font-size:11px; font-weight:800; color:#191919; background:#fee500;
      border:2px solid #111; padding:3px 6px; text-decoration:none;
    }
    .legend {
      display:flex; flex-wrap:wrap; gap:8px 10px;
      padding:10px 14px; border-top:3px solid var(--ink); font-size:11px; font-weight:800;
    }
    .legend i { display:inline-block; width:10px; height:10px; border:2px solid #111; margin-right:4px; vertical-align:-1px; }
    .links { display:flex; gap:8px; padding:10px 14px 12px; }
    .links a {
      flex:1; text-align:center; padding:10px 8px; border:3px solid var(--ink);
      text-decoration:none; color:inherit; font-weight:800; font-size:13px;
    }
    .links a.kakao { background:#fee500; color:#191919; }
    .links a.is-off { opacity:.4; pointer-events:none; }

    .pin {
      width:28px; height:28px; display:grid; place-items:center;
      border:2px solid #111; font:800 12px/1 sans-serif; color:#111;
      box-shadow:2px 2px 0 #111; cursor:pointer;
    }
    .pin.is-on { outline:3px solid #111; transform:scale(1.12); }

    @media (max-width: 720px) {
      .top { flex-wrap:wrap; }
      .tabs {
        order:3; width:100%; flex:1 0 100%;
        display:grid; grid-template-columns:repeat(3, 1fr);
        overflow:visible;
      }
      .tabs button { height:36px; font-size:12px; padding:0; width:100%; }
      .dock {
        top:auto; bottom:0; left:0; right:0; width:100%;
        max-height:42dvh; box-shadow:0 -4px 0 var(--ink); border-left:0; border-right:0; border-bottom:0;
      }
      .leaflet-bottom.leaflet-right { bottom: calc(42dvh + 16px) !important; }
    }
  </style>
</head>
<body>
  <div id="map"></div>

  <div class="top">
    <a class="brand-chip" href="/chuncheon/"><i>A</i>일정</a>
    <div class="tabs" id="tabs"></div>
    <button class="icon-btn theme-toggle" id="theme-toggle" type="button" aria-label="다크 테마로 전환" aria-pressed="false"></button>
  </div>

  <aside class="dock">
    <header>
      <h1 id="panelTitle">기본 동선</h1>
      <p id="note"></p>
    </header>
    <ul class="list" id="list"></ul>
    <div class="legend">
      <span><i style="background:#74b9ff"></i>워터</span>
      <span><i style="background:#ff6b6b"></i>슈퍼차저</span>
      <span><i style="background:#ffa552"></i>음식</span>
      <span><i style="background:#ffd23f"></i>경치</span>
      <span><i style="background:#88d498"></i>숙소</span>
    </div>
    <div class="links">
      <a href="/chuncheon/">일정 글</a>
      <a class="kakao" id="kakaoOpen" target="_blank" rel="noreferrer">카카오 길찾기</a>
    </div>
  </aside>

  <script is:inline id="trip-data" type="application/json" set:html={payload} />
  {kakaoKey && <script is:inline src={`https://dapi.kakao.com/v2/maps/sdk.js?appkey=${kakaoKey}`}></script>}
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script is:inline>
    var DATA = JSON.parse(document.getElementById("trip-data").textContent);
    var useKakao = typeof kakao !== "undefined" && kakao.maps;
    var colors = { sc:"#ff6b6b", water:"#74b9ff", stay:"#88d498", poi:"#ffd23f", food:"#ffa552" };
    var tabOrder = [
      ["base", "기본"],
      ["d27", "가는 날"],
      ["d28", "남이섬"],
      ["d29", "오는 날"],
      ["pick", DATA.pickCount + "곳"],
      ["charge", "충전"]
    ];

    function viewOf(key) {
      if (key === "pick") {
        return {
          title: "얹을 곳 " + DATA.pickCount + "곳",
          note: "기본 선 위에 얹는 들름. 원문은 목록에서 연다. 하루 본전은 소금산.",
          items: DATA.spots.filter(function (s) { return s.days.indexOf("pick") !== -1; }),
          url: "",
          line: false
        };
      }
      if (key === "charge") {
        return {
          title: "충전 보조",
          note: "길을 새로 짜지 않는다. 기본 선에서 필요할 때만.",
          items: DATA.spots.filter(function (s) { return s.kind === "water" || s.kind === "sc"; }),
          url: "",
          line: false
        };
      }
      var c = DATA.courses[key];
      var items = c.lineIds.map(function (id) {
        return DATA.spots.filter(function (s) { return s.id === id; })[0];
      }).filter(Boolean);
      if (c.start === "ulsan") {
        items = [{ kind:"stay", name: DATA.ulsan.name, lat: DATA.ulsan.lat, lng: DATA.ulsan.lng, note:"출발", stayMin:0 }].concat(items);
      }
      if (c.end === "ulsan") {
        items = items.concat([{ kind:"stay", name: DATA.ulsan.name, lat: DATA.ulsan.lat, lng: DATA.ulsan.lng, note:"도착", stayMin:0 }]);
      }
      return { title: c.title, note: c.summary, items: items, url: DATA.urls[key] || "", line: true };
    }

    function kakaoPlace(p) {
      return "https://map.kakao.com/link/map/" + encodeURIComponent(p.name) + "," + p.lat + "," + p.lng;
    }
    function pinHtml(n, kind, on) {
      return '<div class="pin' + (on ? " is-on" : "") + '" data-i="' + n + '" style="background:' + (colors[kind] || "#fff") + '">' + n + "</div>";
    }

    var layer, lmap, kmap, koverlays = [], tileLayer, selected = -1, currentKey = "water";

    function isDark() {
      return document.documentElement.getAttribute("data-theme") === "dark";
    }
    function tileUrl() {
      return isDark()
        ? "https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png"
        : "https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png";
    }
    function applyTiles() {
      if (useKakao || !lmap) return;
      if (tileLayer) lmap.removeLayer(tileLayer);
      tileLayer = L.tileLayer(tileUrl(), { maxZoom: 19, attribution: "&copy; OSM &copy; CARTO" }).addTo(lmap);
    }

    function initMap() {
      if (useKakao) {
        kmap = new kakao.maps.Map(document.getElementById("map"), {
          center: new kakao.maps.LatLng(36.85, 128.05),
          level: 11
        });
      } else {
        lmap = L.map("map", { zoomControl: false }).setView([36.85, 128.05], 8);
        L.control.zoom({ position: "bottomright" }).addTo(lmap);
        applyTiles();
        layer = L.layerGroup().addTo(lmap);
      }
    }

    function clear() {
      if (useKakao) { koverlays.forEach(function (o) { o.setMap(null); }); koverlays = []; }
      else if (layer) layer.clearLayers();
    }

    function mapPad() {
      var mobile = window.matchMedia("(max-width: 720px)").matches;
      if (mobile) return { paddingTopLeft: [16, 150], paddingBottomRight: [16, Math.round(window.innerHeight * 0.44)] };
      return { paddingTopLeft: [380, 80], paddingBottomRight: [48, 48] };
    }

    function fitAll(items) {
      if (!items.length) return;
      var pad = mapPad();
      if (useKakao) {
        var kb = new kakao.maps.LatLngBounds();
        items.forEach(function (p) { kb.extend(new kakao.maps.LatLng(p.lat, p.lng)); });
        kmap.setBounds(kb);
      } else {
        lmap.fitBounds(items.map(function (p) { return [p.lat, p.lng]; }), pad);
      }
    }

    window.__focusStop = function (i, openPlace) {
      var items = window._items || [];
      var p = items[i];
      if (!p) return;
      selected = i;
      document.querySelectorAll(".list li").forEach(function (b, j) {
        b.classList.toggle("is-on", j === i);
      });
      document.querySelectorAll(".pin").forEach(function (el) {
        el.classList.toggle("is-on", Number(el.getAttribute("data-i")) === i + 1);
      });
      var row = document.querySelectorAll(".list li")[i];
      if (row) row.scrollIntoView({ block: "nearest" });
      if (useKakao) {
        kmap.setLevel(6);
        kmap.panTo(new kakao.maps.LatLng(p.lat, p.lng));
      } else {
        lmap.setView([p.lat, p.lng], 12);
      }
      if (openPlace) window.open(kakaoPlace(p), "_blank", "noopener");
    };

    function render(key) {
      currentKey = key;
      selected = -1;
      var v = viewOf(key);
      window._items = v.items;
      document.getElementById("panelTitle").textContent = v.title;
      document.getElementById("note").textContent = v.note;
      var kakaoBtn = document.getElementById("kakaoOpen");
      if (v.url) {
        kakaoBtn.href = v.url;
        kakaoBtn.classList.remove("is-off");
      } else {
        kakaoBtn.removeAttribute("href");
        kakaoBtn.classList.add("is-off");
      }
      document.querySelectorAll(".tabs button").forEach(function (b) {
        b.classList.toggle("on", b.dataset.key === key);
        if (b.dataset.key === key) b.scrollIntoView({ inline: "nearest", block: "nearest" });
      });
      if (history.replaceState) history.replaceState(null, "", "#" + key);
      clear();
      v.items.forEach(function (p, i) {
        var n = String(i + 1);
        if (useKakao) {
          var pos = new kakao.maps.LatLng(p.lat, p.lng);
          var ov = new kakao.maps.CustomOverlay({
            position: pos,
            content: '<div onclick="window.__focusStop(' + i + ')">' + pinHtml(n, p.kind) + "</div>",
            yAnchor: 1
          });
          ov.setMap(kmap);
          koverlays.push(ov);
        } else {
          var m = L.marker([p.lat, p.lng], {
            icon: L.divIcon({ className: "", html: pinHtml(n, p.kind), iconSize: [28, 28], iconAnchor: [14, 28] })
          }).addTo(layer);
          m.on("click", function () { window.__focusStop(i); });
        }
      });
      if (v.line && v.items.length >= 2) {
        if (useKakao) {
          var path = v.items.map(function (p) { return new kakao.maps.LatLng(p.lat, p.lng); });
          var line = new kakao.maps.Polyline({ path: path, strokeWeight: 6, strokeColor: isDark() ? "#f3f3f6" : "#111", strokeOpacity: 0.45, strokeStyle: "solid" });
          line.setMap(kmap);
          koverlays.push(line);
        } else {
          L.polyline(v.items.map(function (p) { return [p.lat, p.lng]; }), {
            color: isDark() ? "#f3f3f6" : "#111", weight: 5, opacity: 0.45
          }).addTo(layer);
        }
      }
      fitAll(v.items);
      var ul = document.getElementById("list");
      ul.innerHTML = "";
      ul.scrollTop = 0;
      v.items.forEach(function (p, i) {
        var li = document.createElement("li");
        var mins = p.stayMin ? p.stayMin + "분" : "";
        li.innerHTML = "<button type='button'><span class='num " + (p.kind || "") + "'>" + (i + 1) + "</span><span><b></b><span class='meta'></span></span></button><span class='side'><span class='mins'></span></span>";
        li.querySelector("b").textContent = p.name;
        li.querySelector(".meta").textContent = p.note || "";
        li.querySelector(".mins").textContent = mins;
        var open = document.createElement("a");
        open.className = "place";
        open.href = kakaoPlace(p);
        open.target = "_blank";
        open.rel = "noreferrer";
        open.textContent = "카카오";
        li.querySelector(".side").appendChild(open);
        if (p.srcUrl) {
          var src = document.createElement("a");
          src.className = "place";
          src.href = p.srcUrl;
          src.target = "_blank";
          src.rel = "noreferrer";
          src.textContent = "원문";
          src.style.background = "var(--surface)";
          src.style.color = "inherit";
          li.querySelector(".side").appendChild(src);
        }
        li.querySelector("button").onclick = function () { window.__focusStop(i); };
        ul.appendChild(li);
      });
    }

    initMap();
    var tabs = document.getElementById("tabs");
    tabOrder.forEach(function (t) {
      var b = document.createElement("button");
      b.type = "button";
      b.textContent = t[1];
      b.dataset.key = t[0];
      b.onclick = function () { render(t[0]); };
      tabs.appendChild(b);
    });
    var startKey = (location.hash || "").replace("#", "");
    if (!DATA.courses[startKey] && startKey !== "pick" && startKey !== "charge") startKey = "base";
    render(startKey);
    window.addEventListener("hashchange", function () {
      var k = (location.hash || "").replace("#", "");
      if (DATA.courses[k] || k === "pick" || k === "charge") render(k);
    });

    new MutationObserver(function () {
      applyTiles();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  </script>
  <script is:inline src="/theme.js"></script>
</body>
</html>
