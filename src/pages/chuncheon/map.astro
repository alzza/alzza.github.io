---
import { ULSAN, ELY, spots, courses, kakaoByCar, kakaoPlace, coursePoints } from "../../data/chuncheon";

const kakaoKey = import.meta.env.PUBLIC_KAKAO_JS_KEY ?? "";
const payload = JSON.stringify({
  ulsan: ULSAN,
  ely: ELY,
  spots,
  courses,
  waterUrl: kakaoByCar(coursePoints("water")),
  scUrl: kakaoByCar(coursePoints("sc")),
});
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem("theme");
        document.documentElement.setAttribute("data-theme", t === "dark" ? "dark" : "light");
      } catch (e) {
        document.documentElement.setAttribute("data-theme", "light");
      }
    })();
  </script>
  <title>춘천 경로 · 워터 / SC · 카카오맵</title>
  <meta name="theme-color" content="#FFD23F" data-light="#FFD23F" data-dark="#14131a" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <style is:global>
    :root {
      --ink:#000; --text:#000; --muted:#57534e; --surface:#fff; --bg:#fffdf5;
      --sc:#cc0000; --water:#0077c8; --stay:#0f766e; --poi:#a16207; --yellow:#ffd23f;
    }
    [data-theme="dark"] {
      --ink:#f3f3f6; --text:#ececed; --muted:#a6a6b0; --surface:#1f1e28; --bg:#14131a;
    }
    * { box-sizing: border-box; }
    html, body { height:100%; margin:0; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Apple SD Gothic Neo",sans-serif; color:var(--text); background:var(--bg); }
    header {
      position:absolute; top:0; left:0; right:0; z-index:500;
      display:flex; flex-wrap:wrap; align-items:center; gap:8px 12px;
      padding:8px 12px; background:var(--surface); border-bottom:3px solid var(--ink);
    }
    h1 { margin:0; font-size:15px; }
    .sub { margin:0; font-size:11px; color:var(--muted); }
    .tabs, .acts { display:flex; flex-wrap:wrap; gap:6px; }
    button, .acts a {
      appearance:none; border:2px solid var(--ink); background:var(--surface); color:var(--text);
      padding:6px 10px; font:700 12px/1 inherit; cursor:pointer; text-decoration:none;
    }
    button.on { background:var(--ink); color:var(--bg); }
    .acts a.kakao { background:#FEE500; color:#191919; border-color:#111; }
    .map-top { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; width:100%; }
    .theme-toggle {
      display:inline-flex; align-items:center; justify-content:center;
      width:38px; height:38px; padding:0; margin-left:auto; flex-shrink:0;
    }
    .theme-toggle svg { width:18px; height:18px; display:block; }
    .theme-toggle .icon-sun { display:none; }
    [data-theme="dark"] .theme-toggle .icon-moon { display:none; }
    [data-theme="dark"] .theme-toggle .icon-sun { display:block; }
    #map { position:absolute; inset:96px 0 0; }
    .panel {
      position:absolute; z-index:400; top:108px; left:12px; width:min(360px, calc(100vw - 24px));
      max-height:calc(100vh - 128px); overflow:auto; background:var(--surface); border:2px solid var(--ink);
      box-shadow:4px 4px 0 var(--ink);
    }
    .panel h2 { margin:0; padding:10px 12px; font-size:13px; border-bottom:1px solid color-mix(in srgb, var(--ink) 18%, transparent); }
    .list { list-style:none; margin:0; padding:0; }
    .list a { display:block; padding:8px 12px; color:inherit; text-decoration:none; border-top:1px solid color-mix(in srgb, var(--ink) 10%, transparent); }
    .list a:hover { background:var(--yellow); color:#000; }
    .tag { display:inline-block; min-width:36px; margin-right:6px; padding:1px 5px; font-size:10px; font-weight:800; color:#fff; }
    .sc { background:var(--sc); } .water { background:var(--water); }
    .stay { background:var(--stay); } .poi { background:var(--poi); } .food { background:#c2410c; }
    .note { padding:8px 12px 12px; font-size:11px; color:var(--muted); }
    #top-sentinel { position:absolute; top:0; left:0; width:1px; height:1px; }
    .back-to-top {
      position:fixed; bottom:1.5rem; right:1.5rem; z-index:600;
      width:52px; height:52px; display:flex; align-items:center; justify-content:center;
      padding:0; border:3px solid var(--ink); background:var(--yellow); color:#000;
      box-shadow:5px 5px 0 0 var(--ink); font:700 1.5rem/1 inherit; cursor:pointer;
      opacity:0; visibility:hidden;
    }
    .back-to-top.is-visible { opacity:1; visibility:visible; }
  </style>
</head>
<body>
  <div id="top-sentinel" aria-hidden="true"></div>
  <header>
    <div class="map-top">
      <div>
        <h1>워터 / SC 코스 · 카카오맵</h1>
        <p class="sub">출발 100% (최소 80%). 길찾기는 카카오 자동차. 레일바이크 없음.</p>
      </div>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="다크 테마로 전환" aria-pressed="false"></button>
    </div>
    <div class="tabs" id="tabs"></div>
    <div class="acts">
      <a href="/chuncheon/">일정</a>
      <a href="/">목록</a>
      <a class="kakao" id="kakaoOpen" target="_blank" rel="noreferrer">이 코스 카카오 길찾기</a>
    </div>
  </header>
  <aside class="panel">
    <h2 id="panelTitle">코스</h2>
    <ul class="list" id="list"></ul>
    <p class="note" id="note"></p>
  </aside>
  <div id="map"></div>
  <script is:inline id="trip-data" type="application/json" set:html={payload} />
  {kakaoKey && <script is:inline src={`https://dapi.kakao.com/v2/maps/sdk.js?appkey=${kakaoKey}`}></script>}
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script is:inline>
    var DATA = JSON.parse(document.getElementById("trip-data").textContent);
    var useKakao = typeof kakao !== "undefined" && kakao.maps;
    var colors = { sc: "#cc0000", water: "#0077c8", stay: "#0f766e", poi: "#a16207", food: "#c2410c" };
    var lab = { sc: "SC", water: "워터", stay: "숙소", poi: "관광", food: "식사" };

    function kakaoPlace(p) {
      return "https://map.kakao.com/link/map/" + encodeURIComponent(p.name) + "," + p.lat + "," + p.lng;
    }
    function kakaoCar(pts) {
      return "https://map.kakao.com/link/by/car/" + pts.map(function (p) {
        return encodeURIComponent(p.name) + "," + p.lat + "," + p.lng;
      }).join("/");
    }

    var views = {
      water: { title: "워터 우선", note: DATA.courses.water.summary + " 집 100%(최소 80%). 문경 양평이 주충전.", ids: DATA.courses.water.lineIds, url: DATA.waterUrl },
      sc: { title: "슈퍼차저 우선", note: DATA.courses.sc.summary, ids: DATA.courses.sc.lineIds, url: DATA.scUrl },
      d27: { title: "8/27 가는 날", note: "06:00 울산. 밥+워터는 문경 양평. 관광은 소금산. 입실 15:00.", filter: "d27" },
      d28: { title: "8/28 남이섬", note: "남이섬 필수. 제이드가든. 레일바이크 없음.", filter: "d28" },
      d29: { title: "8/29 오는 날", note: "11:00 아웃. 워터는 창원 방향만. 또는 가평 서울 SC.", filter: "d29" },
      pick: { title: "추천 12곳", note: "차로 짧게. 하루 본전은 소금산 하나. 나머지는 후보.", filter: "pick" }
    };

    function itemsOf(key) {
      var v = views[key];
      var start = { kind: "stay", name: DATA.ulsan.name, lat: DATA.ulsan.lat, lng: DATA.ulsan.lng, note: "출발" };
      if (v.ids) {
        return [start].concat(v.ids.map(function (id) {
          return DATA.spots.filter(function (s) { return s.id === id; })[0];
        }).filter(Boolean));
      }
      return DATA.spots.filter(function (s) { return s.days.indexOf(v.filter) !== -1; });
    }

    var layer;
    var kmap, koverlays = [];

    function leafletIcon(color) {
      return L.divIcon({
        className: "",
        html: '<div style="width:16px;height:16px;border:2px solid #111;border-radius:50%;background:' + color + ';box-shadow:1px 1px 0 #111"></div>',
        iconSize: [16, 16], iconAnchor: [8, 8]
      });
    }

    function initMap() {
      if (useKakao) {
        kmap = new kakao.maps.Map(document.getElementById("map"), {
          center: new kakao.maps.LatLng(36.7, 128.1),
          level: 11
        });
      } else {
        var map = L.map("map").setView([36.7, 128.1], 8);
        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
          maxZoom: 18, attribution: "&copy; OpenStreetMap"
        }).addTo(map);
        layer = L.layerGroup().addTo(map);
        window._lmap = map;
      }
    }

    function clearOverlays() {
      if (useKakao) {
        koverlays.forEach(function (o) { o.setMap(null); });
        koverlays = [];
      } else if (layer) layer.clearLayers();
    }

    function render(key) {
      var v = views[key];
      var items = itemsOf(key);
      document.getElementById("panelTitle").textContent = v.title;
      document.getElementById("note").textContent = v.note;
      var routePts = items.map(function (p) { return { name: p.name, lat: p.lat, lng: p.lng }; });
      if (v.url) document.getElementById("kakaoOpen").href = v.url;
      else if (routePts.length >= 2) document.getElementById("kakaoOpen").href = kakaoCar([DATA.ulsan].concat(routePts).slice(0, 7));
      document.querySelectorAll(".tabs button").forEach(function (b) {
        b.classList.toggle("on", b.dataset.key === key);
      });
      clearOverlays();
      var bounds = [];
      items.forEach(function (p) {
        bounds.push([p.lat, p.lng]);
        if (useKakao) {
          var pos = new kakao.maps.LatLng(p.lat, p.lng);
          var marker = new kakao.maps.Marker({ map: kmap, position: pos });
          var info = new kakao.maps.InfoWindow({
            content: "<div style='padding:6px 8px;font-size:12px'><b>" + p.name + "</b><br>" + (p.note || "") + "</div>"
          });
          kakao.maps.event.addListener(marker, "click", function () { info.open(kmap, marker); });
          koverlays.push(marker);
        } else {
          L.marker([p.lat, p.lng], { icon: leafletIcon(colors[p.kind] || "#333") })
            .addTo(layer)
            .bindPopup("<b>" + p.name + "</b><br>" + (p.note || "") + "<br><a target='_blank' href='" + kakaoPlace(p) + "'>카카오맵</a>");
        }
      });
      if (items.length >= 2) {
        if (useKakao) {
          var path = items.map(function (p) { return new kakao.maps.LatLng(p.lat, p.lng); });
          var line = new kakao.maps.Polyline({ path: path, strokeWeight: 4, strokeColor: "#111", strokeOpacity: 0.55 });
          line.setMap(kmap);
          koverlays.push(line);
          var kb = new kakao.maps.LatLngBounds();
          path.forEach(function (x) { kb.extend(x); });
          kmap.setBounds(kb);
        } else {
          L.polyline(bounds, { color: "#111", weight: 4, opacity: 0.55 }).addTo(layer);
          window._lmap.fitBounds(L.latLngBounds(bounds).pad(0.2));
        }
      }
      var list = document.getElementById("list");
      list.innerHTML = "";
      items.forEach(function (p) {
        var li = document.createElement("li");
        li.innerHTML = "<a target='_blank' href='" + kakaoPlace(p) + "'><span class='tag " + p.kind + "'>" + (lab[p.kind] || p.kind) + "</span>" + p.name + "<br><span style='color:#78716c;font-size:11px'>" + (p.note || "") + "</span></a>";
        list.appendChild(li);
      });
    }

    initMap();
    var tabs = document.getElementById("tabs");
    [["water", "워터 코스"], ["sc", "SC 코스"], ["d27", "27 가는 날"], ["d28", "28 남이섬"], ["d29", "29 오는 날"], ["pick", "추천 12"]].forEach(function (t) {
      var b = document.createElement("button");
      b.textContent = t[1];
      b.dataset.key = t[0];
      b.onclick = function () { render(t[0]); };
      tabs.appendChild(b);
    });
    render("water");
  </script>
  <button class="back-to-top" id="back-to-top" type="button" aria-label="맨 위로">↑</button>
  <script is:inline src="/theme.js"></script>
</body>
</html>
