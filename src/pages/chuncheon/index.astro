---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import CourseMap from "../../components/CourseMap.astro";
import {
  ULSAN,
  ELY,
  courses,
  coursePoints,
  kakaoByCar,
  kakaoPlace,
  spots,
} from "../../data/chuncheon";

const waterUrl = kakaoByCar(coursePoints("water"));
const scUrl = kakaoByCar(coursePoints("sc"));
const picks = spots.filter((s) => s.days.includes("pick"));
---

<Base title="춘천 · 엘리시안강촌" description="혼자 가는 울산-강촌. 워터 먼저, 카카오맵.">
  <Header
    links={[
      { href: "/", label: "목록" },
      { href: "/chuncheon/map/", label: "큰 지도", accent: true },
    ]}
  />

  <section class="hero-band">
    <div class="wrap">
      <span class="badge badge-pink">8/27-29</span>
      <h1>울산에서 강촌까지, <em>혼자 운전.</em></h1>
      <p>목 새벽 여섯 시 출발, 토 열한 시 나옴. 남이섬은 금요일 오전. 레일바이크는 안 탐.</p>
    </div>
  </section>
  <hr class="divider-band" />

  <div class="wrap">
    <p class="sec-label" style="margin-top:28px">배터리</p>
    <article class="day">
      <p>집은 <strong>100%</strong>로 출발. 못해도 <strong>80%</strong>. 고속도로면 한 번에 끝까지 가기엔 빠듯하니, 문경에서 밥 먹으며 채우는 쪽을 기본으로 둠.</p>
      <p>리조트엔 급속이 없고 지하 차지비 7kW만 있음. 올라가는 길은 워터 <strong>양평 방향</strong>. 괴산·서여주·문경 창원 방향은 <strong>내려올 때만</strong>.</p>
    </article>

    <p class="sec-label">두 가지 길</p>
    <div class="course-grid">
      <article class="course-card featured">
        <span class="badge">추천</span>
        <h2>{courses.water.title}</h2>
        <p>{courses.water.summary}</p>
        <a class="btn" href={waterUrl} target="_blank" rel="noreferrer">카카오 길찾기</a>
      </article>
      <article class="course-card">
        <h2>{courses.sc.title}</h2>
        <p>{courses.sc.summary}</p>
        <a class="btn" href={scUrl} target="_blank" rel="noreferrer">카카오 길찾기</a>
      </article>
    </div>

    <p class="sec-label">지도</p>
    <CourseMap />
    <p class="note-meta" style="margin-top:-16px;margin-bottom:28px">
      길찾기는 카카오. 키를 넣으면 카카오 지도가 뜨고, 없으면 배경만 OSM이다.
      <a href="/chuncheon/map/">크게 보기</a>
    </p>

    <article class="day">
      <h2>27일 목 · 가는 날</h2>
      <table>
        <tr><th>06:00</th><td>울산. SOC 100% (최소 80%)</td></tr>
        <tr><th>아침</th><td>중부내륙. 배고프면 선산휴게소 양평 국밥 + 워터</td></tr>
        <tr><th>09:00</th><td>문경휴게소 양평. 오미자돈가스나 국밥. 워터 350kW가 이날 본충전</td></tr>
        <tr><th>잠깐</th><td>문경새재 1관문 20분. 시간 없으면 통과</td></tr>
        <tr><th>11:00</th><td>소금산 그랜드밸리. 주차 무료. 월 휴장, 목 가능</td></tr>
        <tr><th>13:30</th><td>가평휴게소 춘천. 맛남샌드. 옆 V4</td></tr>
        <tr><th>15:00</th><td>엘리시안. 저녁 닭갈비는 1인인지 전화</td></tr>
      </table>
    </article>

    <article class="day">
      <h2>28일 금 · 남이섬</h2>
      <table>
        <tr><th>오전</th><td>남이섬. 성인 19,000 (배 왕복). 주차 6,000</td></tr>
        <tr><th>오후</th><td>제이드가든. 여유면 자라섬 잔디, 소양강 스카이워크</td></tr>
        <tr><th>저녁</th><td>명동 닭갈비골목 또는 강촌 막국수. 숙소 완속 7kW</td></tr>
      </table>
    </article>

    <article class="day">
      <h2>29일 토 · 오는 날</h2>
      <table>
        <tr><th>11:00</th><td>나옴. 관광 더 안 함</td></tr>
        <tr><th>충전</th><td>워터는 창원 방향 (서여주·괴산·문경). 아니면 가평 서울 V4</td></tr>
        <tr><th>낮</th><td>열두 시 전에 고속도로. 울산</td></tr>
      </table>
    </article>

    <p class="sec-label">음식 · 경치 {picks.length}곳</p>
    <p style="margin:-4px 0 14px;max-width:52ch;color:var(--muted)">
      2024-2026 후기 기준. 차로 내려서 20-40분 쉬는 곳 위주. 하루 본전은 소금산 하나.
      레일바이크 없음.
    </p>
    <div class="pick-grid">
      {
        picks.map((p) => (
          <a class="pick-card" href={kakaoPlace(p)} target="_blank" rel="noreferrer">
            <span class="kicker">{p.tag} · {p.stayMin}분</span>
            <h3>{p.name}</h3>
            <p>{p.note}</p>
            <small>{p.src}</small>
          </a>
        ))
      }
    </div>

    <article class="day">
      <h2>숙소</h2>
      <p>
        <a href={kakaoPlace(ELY)} target="_blank" rel="noreferrer">엘리시안 강촌</a>
        . 들어감 15:00, 나옴 11:00. 주차 무료. 급속 없음.
      </p>
      <p>
        출발은 <a href={kakaoPlace(ULSAN)} target="_blank" rel="noreferrer">울산</a>.
      </p>
    </article>

    <footer class="site-foot"><a href="/">목록으로</a></footer>
  </div>
</Base>
