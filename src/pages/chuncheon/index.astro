---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import CourseMap from "../../components/CourseMap.astro";
import {
  ULSAN,
  ELY,
  courses,
  coursePoints,
  kakaoByCar,
  kakaoPlace,
  pickSpots,
} from "../../data/chuncheon";

const baseUrl = kakaoByCar(coursePoints("base"));
const d27Url = kakaoByCar(coursePoints("d27"));
const picks = pickSpots();
const byBand = {
  go: picks.filter((p) => p.band === "go"),
  stay: picks.filter((p) => p.band === "stay"),
  back: picks.filter((p) => p.band === "back"),
};
const bandLabel = { go: "가는 길에 얹기", stay: "숙소 근처 · 28일", back: "오는 길에 얹기" };
---

<Base title="춘천 · 엘리시안강촌" description="울산에서 강촌까지 기본 동선. 들름은 그 위에." noindex>
  <Header
    links={[
      { href: "/", label: "목록" },
      { href: "/chuncheon/map/", label: "큰 지도", accent: true },
    ]}
  />

  <section class="hero-band">
    <div class="wrap">
      <span class="badge badge-pink">8/27-29</span>
      <h1>울산에서 강촌까지, <em>혼자 운전.</em></h1>
      <p>목 새벽 여섯 시 출발, 토 열한 시 나옴. 남이섬은 금요일 오전. 레일바이크는 안 탐.</p>
    </div>
  </section>
  <hr class="divider-band" />

  <div class="wrap">
    <p class="sec-label" style="margin-top:28px">기본 동선</p>
    <article class="day">
      <p>
        집은 <strong>울산</strong>, 숙소는 <strong>엘리시안 강촌</strong>.
        길은 경부에서 상주영천, 중앙으로 붙는 쪽을 기본으로 둠.
        카카오 길찾기도 이 두 점만.
      </p>
      <p>
        들를 곳은 이 선 위에 얹는다. 워터·슈퍼차저도 길을 새로 짜는 게 아니라, 배터리 떨어질 때 그 선에서 잠깐 빠지는 보조다.
      </p>
      <p style="margin-top:14px;display:flex;gap:8px;flex-wrap:wrap">
        <a class="btn btn-accent" href={baseUrl} target="_blank" rel="noreferrer">기본 길 카카오</a>
        <a class="btn" href={d27Url} target="_blank" rel="noreferrer">소금산 얹은 길</a>
      </p>
    </article>

    <p class="sec-label">배터리 (보조)</p>
    <article class="day">
      <p>집은 <strong>100%</strong>로 출발. 못해도 <strong>80%</strong>. 한 번에 끝까지는 빠듯하다.</p>
      <p>
        기본 길 위: 김천 모다, 제천 남제천IC, 원주 AK, 가평 V4.
        중부내륙으로 밥 먹으며 빼고 싶으면 워터는 <strong>양평 방향</strong>만.
        괴산·서여주·문경 <strong>창원 방향</strong>은 내려올 때만.
      </p>
      <p>리조트엔 급속이 없고 지하 차지비 7kW만 있음.</p>
    </article>

    <p class="sec-label">지도</p>
    <CourseMap />
    <p class="note-meta" style="margin-top:-16px;margin-bottom:28px">
      길찾기는 카카오. 키를 넣으면 카카오 지도가 뜨고, 없으면 배경만 OSM이다.
      <a href="/chuncheon/map/">크게 보기</a>
    </p>

    <article class="day">
      <h2>27일 목 · 가는 날</h2>
      <table>
        <tr><th>기본</th><td>06:00 울산. 경부-상주영천-중앙. 15:00 엘리시안.</td></tr>
        <tr><th>충전</th><td>필요하면 김천 모다(경부 옆). 아니면 제천·원주.</td></tr>
        <tr><th>더하면</th><td>소금산 그랜드밸리. 월 휴장, 목 가능. 주차 무료.</td></tr>
        <tr><th>시간 있으면</th><td>안동 월영교, 단양 도담삼봉, 제천 의림지. 아래 30곳.</td></tr>
      </table>
    </article>

    <article class="day">
      <h2>28일 금 · 남이섬</h2>
      <table>
        <tr><th>필수</th><td>남이섬. 성인 19,000 (배 왕복). 주차는 현장.</td></tr>
        <tr><th>더하면</th><td>제이드가든. 여유면 자라섬 잔디, 소양강 스카이워크.</td></tr>
        <tr><th>저녁</th><td>강촌찐해물칼국수 또는 설악막국수 강촌점. 1인인지 전화. 숙소 완속 7kW.</td></tr>
      </table>
    </article>

    <article class="day">
      <h2>29일 토 · 오는 날</h2>
      <table>
        <tr><th>기본</th><td>11:00 나옴. 관광 더 안 함. 고속도로 울산.</td></tr>
        <tr><th>충전</th><td>가평 서울 V4, 아니면 창원 방향 워터.</td></tr>
      </table>
    </article>

    <p class="sec-label">기본 길에 얹는 30곳</p>
    <p style="margin:-4px 0 14px;max-width:56ch;color:var(--muted)">
      네이버·다음·구글에서 개인 블로그, 인스타 릴스, 유튜브 쇼츠를 찾아 2024-2026 글만 골랐다.
      원문을 열어 영업·휴무를 다시 본다. X는 스팸이 많아 안 썼다.
      하루 본전은 소금산 하나. 레일바이크 없음.
    </p>
    {
      (["go", "stay", "back"] as const).map((band) => (
        <>
          <p class="sec-label" style="margin-top:8px">{bandLabel[band]} · {byBand[band].length}</p>
          <div class="pick-grid">
            {byBand[band].map((p) => (
              <article class="pick-card">
                <span class="kicker">{p.tag} · {p.stayMin}분</span>
                <h3>{p.name}</h3>
                <p>{p.note}</p>
                <div class="pick-links">
                  <a href={kakaoPlace(p)} target="_blank" rel="noreferrer">카카오</a>
                  <a href={p.srcUrl} target="_blank" rel="noreferrer">원문 · {p.src}</a>
                </div>
              </article>
            ))}
          </div>
        </>
      ))
    }

    <article class="day">
      <h2>숙소</h2>
      <p>
        <a href={kakaoPlace(ELY)} target="_blank" rel="noreferrer">엘리시안 강촌</a>
        . 들어감 15:00, 나옴 11:00. 주차 무료. 급속 없음.
      </p>
      <p>
        출발은 <a href={kakaoPlace(ULSAN)} target="_blank" rel="noreferrer">울산</a>.
      </p>
    </article>

    <footer class="site-foot"><a href="/">목록으로</a></footer>
  </div>
</Base>
