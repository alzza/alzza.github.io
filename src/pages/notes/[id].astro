---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Comments from "../../components/Comments.astro";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes.map((note) => ({
    params: { id: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
---

<Base title={`${note.data.title} · alzza`} description={note.data.excerpt}>
  <Header links={[{ href: "/notes/", label: "노트" }, { href: "/info/", label: "정보" }]} />
  <div class:list={["wrap", "prose", { "prose-plc": note.data.tags.includes("PLC") }]}>
    <section class="hero">
      <span class="badge">노트</span>
      <h1>{note.data.title}</h1>
      <p class="note-meta">{note.data.date}</p>
      {
        note.data.tags.length > 0 && (
          <p class="note-tags">
            {note.data.tags.map((t: string) => (
              <a href={`/notes/?tag=${encodeURIComponent(t)}`}>#{t}</a>
            ))}
          </p>
        )
      }
    </section>
    <Content />
    <Comments />
  </div>
</Base>
