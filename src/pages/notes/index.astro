---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import ModuleBar from "../../modules/ModuleBar.astro";
import TagFilter from "../../modules/TagFilter.astro";
import InsightGrid from "../../modules/InsightGrid.astro";
import BoardList from "../../modules/BoardList.astro";
import { allTags, listNotes } from "../../lib/notes";

const notes = await listNotes();
const tags = allTags(notes);
---

<Base title="노트 · alzza" description="태그로 찾고, 카드나 게시판으로 조립하는 노트 목록">
  <Header links={[{ href: "/", label: "목록" }, { href: "/info/", label: "정보" }]} />
  <div class="wrap">
    <section class="hero">
      <h1>노트</h1>
      <p>태그와 검색으로 고릅니다. 바로 아래 노란 버튼이 검색창, 카드, 게시판 켜고 끄기입니다.</p>
    </section>
    <ModuleBar />
    <TagFilter tags={tags} />
    <InsightGrid notes={notes} />
    <BoardList notes={notes} />
  </div>
  <script is:inline src="/notes-kit.js"></script>
</Base>
