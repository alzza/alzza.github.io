---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import { listNotes } from "../../lib/notes";

const notes = await listNotes();
---

<Base title="노트 · alzza" description="짧은 메모와 코드 노트">
  <Header links={[{ href: "/", label: "목록" }, { href: "/info/", label: "정보" }]} />
  <div class="wrap">
    <section class="hero">
      <h1>노트</h1>
      <p>목록은 게시판처럼. 글은 Markdown으로 올립니다.</p>
    </section>
    <div class="board">
      {
        notes.map((note) => (
          <a class="board-row" href={note.href}>
            <span class="board-date">{note.date}</span>
            <span>
              <span class="board-title">{note.title}</span>
              <span class="board-ex">{note.excerpt}</span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</Base>
